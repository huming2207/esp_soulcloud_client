menu "Soulcloud client"

    config SOULCLOUD_DEVICE_UID
        string "Device UID (MQTT username + client ID)"
        default "esp32-demo-0001"
        help
            Hardware-facing identifier. Must be unique platform-wide and
            contain no '/', '+', '#' or whitespace.

    config SOULCLOUD_DEVICE_PASSWORD
        string "Device MQTT password"
        default ""
        help
            Credential issued by POST /v1/devices/:id/credentials.
            Stored in NVS (plaintext; flash encryption is a production
            concern). Empty = unconfigured; the device will not connect.

    config SOULCLOUD_SERIAL
        string "Device serial (stat.sn)"
        default ""
        help
            Empty = derive from the WiFi station MAC (12 hex chars).

    config SOULCLOUD_BROKER_URI
        string "MQTT broker URI"
        default "ws://192.168.1.100:1883/mqtt"
        help
            MQTT over WebSocket endpoint. Use wss:// for TLS.

    config SOULCLOUD_API_BASE_URL
        string "Soulcloud API base URL"
        default "http://192.168.1.100:8080"
        help
            Prefix prepended to the relative OTA download url from the
            ota notice. Use https:// for TLS.

    config SOULCLOUD_STAT_INTERVAL_S
        int "Stat report interval (seconds)"
        default 120
        range 10 86400

    config SOULCLOUD_LOG_RATE_PER_S
        int "Log uplink rate limit (packets per second)"
        default 10
        range 1 20
        help
            Server-side uplink guard allows 20 packet tokens/s with burst
            100. A raw publish costs one token; an aggregated container costs
            one token per element. The device mirrors that accounting with an
            80-token log burst, reserving server capacity for stat/command/OTA
            results, and emits DROPPED packets on queue/publish failure.

    config SOULCLOUD_LOG_QUEUE_LEN
        int "Log TX queue length (packets)"
        default 32
        range 4 256

    config SOULCLOUD_MQTT_BUFFER_IN
        int "MQTT input buffer size (bytes)"
        default 4096
        range 1024 65536
        help
            esp-mqtt receive buffer; must fit the largest downlink packet.

    config SOULCLOUD_MQTT_BUFFER_OUT
        int "MQTT output buffer size (bytes)"
        default 8192
        range 1024 65536
        help
            esp-mqtt send buffer; must fit the largest on9log packet.

    config SOULCLOUD_MQTT_KEEPALIVE_S
        int "MQTT keepalive (seconds)"
        default 60
        range 10 3600

    config SOULCLOUD_MQTT_RECONNECT_TIMEOUT_MS
        int "MQTT auto-reconnect interval (ms)"
        default 10000
        range 1000 300000

    config SOULCLOUD_OTA_MAX_BYTES
        int "OTA maximum image size (bytes)"
        default 4194304
        range 65536 8388608
        help
            Refuse OTA notices whose bin_size exceeds this (partition guard).

    config SOULCLOUD_OTA_TIMEOUT_S
        int "OTA download watchdog (seconds)"
        default 120
        range 10 3600

    config SOULCLOUD_CORE_TASK_STACK
        int "Client core task stack size (bytes)"
        default 16384
        range 8192 65536
        help
            Stack for the dedicated task that dispatches inbound commands
            and OTA notices. Handlers are application code and may use
            deep stacks, so this must NOT run on the small esp-mqtt or
            esp_timer task stacks (defaults 6144/3584 bytes).

    choice SOULCLOUD_CORE_TASK_STACK_MEMORY
        prompt "Client core task stack memory"
        default SOULCLOUD_CORE_TASK_STACK_INTERNAL
        help
            Internal SRAM is always safe when flash cache is disabled.
            PSRAM preserves internal memory, but the application must route
            every flash operation (including NVS used by command handlers)
            through an internal-stack worker such as esp_flash_dispatcher.

        config SOULCLOUD_CORE_TASK_STACK_INTERNAL
            bool "Internal SRAM"

        config SOULCLOUD_CORE_TASK_STACK_PSRAM
            bool "PSRAM"
            depends on FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
    endchoice

    config SOULCLOUD_LOG_RB_SIZE
        int "Log ring buffer size (bytes)"
        default 16384
        range 1024 262144
        help
            FreeRTOS ring buffer between the on9log sink (producer, runs
            on the log source's task) and the core dispatch task
            (consumer, publishes to MQTT with throttling). The sink
            enqueues with a zero-tick wait, so a full buffer simply drops
            the packet (logs are lossy telemetry). Overridable at runtime
            via the "rb_size" NVS key (setConfig).
            NOSPLIT reserves internal item metadata and must still admit
            one 4096-byte packet; init rejects smaller effective capacities.

    choice SOULCLOUD_LOG_RB_MEM
        prompt "Log ring buffer memory"
        default SOULCLOUD_LOG_RB_MEM_INTERNAL
        help
            Where the log ring buffer is allocated. Internal SRAM is
            always safe (flash writes during OTA suspend the cache, and
            PSRAM access in that window panics); PSRAM trades that for a
            bigger buffer on devices with external RAM.

    config SOULCLOUD_LOG_RB_MEM_INTERNAL
        bool "Internal SRAM"

    config SOULCLOUD_LOG_RB_MEM_PSRAM
        bool "PSRAM"

    endchoice

    config SOULCLOUD_LOG_RB_FLUSH_AT
        int "Log ring buffer flush watermark (bytes)"
        default 8192
        range 256 262144
        help
            When the ring buffer's free space drops below this many bytes
            (batching mode), the accumulated batch is flushed immediately
            to relieve backpressure before packets start getting dropped.
            Overridable at runtime via the "rb_flush" NVS key.

    config SOULCLOUD_LOG_BATCH_COUNT
        int "Log batch count (packets per publish; 1 = disabled)"
        default 1
        range 1 4096
        help
            When > 1, log packets are accumulated and published as one
            aggregated container (PROTOCOL.log-packaging.md) once this
            many packets are queued, the batch byte budget is reached,
            the force-flush timeout elapses, or the ring buffer hits the
            watermark. 1 keeps the legacy single-packet behaviour with
            the lowest latency. Overridable via the "batch_cnt" NVS key.

    config SOULCLOUD_LOG_BATCH_TIMEOUT_MS
        int "Log batch force-flush timeout (ms; 0 = disabled)"
        default 0
        range 0 60000
        help
            Force-flush a non-empty batch this long after it started.
            0 disables the timer (flush driven by count/bytes/watermark
            only). Overridable via the "batch_to" NVS key.

    config SOULCLOUD_INBOUND_MAX
        int "Inbound command/OTA payload buffer (bytes)"
        default 4096
        range 1024 16384
        help
            Maximum size of a single inbound cmd/exec or ota payload.
            Larger payloads are dropped with a warning (QoS1
            retransmission covers commands).

    config SOULCLOUD_INBOUND_RB_SIZE
        int "Inbound ring buffer size (bytes)"
        default 16384
        range 4096 65536
        help
            Total capacity of the FreeRTOS ring buffer that queues inbound
            cmd/exec and ota payloads between the MQTT event callback and
            the core dispatch task. A burst of messages is drained in
            order; when full, the callback waits up to 100 ms then drops.
            NOSPLIT stores items whole and the largest storable item is
            roughly half the buffer minus its internal item header. init
            queries the actual limit and fails with ESP_ERR_INVALID_ARG if
            one (4 + INBOUND_MAX)-byte record cannot fit.
            (backpressure). Allocated from PSRAM when available.

endmenu
